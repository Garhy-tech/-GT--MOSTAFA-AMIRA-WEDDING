{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garhy.ai/schemas/invite-event.schema.json",
  "title": "GARHY INVITE Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "type", "title", "startsAt", "endsAt", "timezone", "sections"],
  "properties": {
    "id": { "type": "string", "minLength": 3, "maxLength": 120 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "type": "string", "enum": ["wedding", "engagement", "birthday", "conference", "opening", "grand_opening", "graduation", "corporate", "vip", "custom"] },
    "status": { "type": "string", "enum": ["draft", "preview", "published", "archived"], "default": "draft" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "subtitle": { "type": "string", "maxLength": 160 },
    "titleAr": { "type": "string", "maxLength": 160 },
    "description": { "type": "string", "maxLength": 800 },
    "descriptionAr": { "type": "string", "maxLength": 800 },
    "startsAt": { "type": "string", "format": "date-time" },
    "endsAt": { "type": "string", "format": "date-time" },
    "rsvpOpensAt": { "type": "string", "format": "date-time" },
    "rsvpClosesAt": { "type": "string", "format": "date-time" },
    "archiveAfterDays": { "type": "integer", "minimum": 0, "maximum": 3650, "default": 45 },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 80 },
    "defaultLocale": { "type": "string", "enum": ["ar", "en"], "default": "ar" },
    "locales": { "type": "array", "items": { "type": "string", "enum": ["ar", "en"] }, "uniqueItems": true, "minItems": 1 },
    "assetOrigin": { "type": "string", "format": "uri" },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "nameAr": { "type": "string", "maxLength": 120 },
          "role": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "nameAr": { "type": "string", "maxLength": 160 },
        "area": { "type": "string", "maxLength": 160 },
        "city": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 300 },
        "addressAr": { "type": "string", "maxLength": 300 },
        "mapsUrl": { "type": "string", "format": "uri" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "type": "string", "maxLength": 80 },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "musicUrl": { "type": "string", "format": "uri-reference" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "music": { "type": "boolean" }, "gallery": { "type": "boolean" }, "calendar": { "type": "boolean" },
        "guestPersonalization": { "type": "boolean" }, "guestPass": { "type": "boolean" }, "lifecycle": { "type": "boolean" }, "bilingual": { "type": "boolean" }
      }
    },
    "rsvp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "closesAt": { "type": "string", "format": "date-time" },
        "maxGuests": { "type": "integer", "minimum": 1, "maximum": 20 },
        "allowEdit": { "type": "boolean", "default": true },
        "questions": { "type": "array", "items": { "type": "object", "additionalProperties": true, "required": ["id", "type", "label"] } }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "enum": ["blessing", "hero", "countdown", "story", "details", "moments", "gallery", "speakers", "agenda", "location", "venue", "rsvp", "dua", "wishes", "contact", "pass", "custom"] },
          {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "kind", "enabled"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
              "kind": { "type": "string" },
              "enabled": { "type": "boolean" }
            }
          }
        ]
      }
    }
  }
}

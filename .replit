modules = ["web", "nodejs-24"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node -e \"const http=require('http'),fs=require('fs'),path=require('path');const mime={'html':'text/html','css':'text/css','js':'text/javascript','png':'image/png','jpg':'image/jpeg','svg':'image/svg+xml','ico':'image/x-icon','mp3':'audio/mpeg','woff2':'font/woff2'};http.createServer((req,res)=>{const u=req.url.split('?')[0];let f=path.join('.',u==='/'?'/index.html':u);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end('Not found');}else{res.writeHead(200,{'Content-Type':mime[path.extname(f).slice(1)]||'text/plain','Cache-Control':'no-cache'});res.end(d);}});}).listen(5000,()=>console.log('Serving on 5000'));\""
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
